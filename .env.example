# Android Emulator -> host Mac's Spring Boot server.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api/v1

# Optional: set after `eas init` to fetch an Expo Push Token.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Submission-safe default: no Firebase/FCM file is needed in this mode.
EXPO_PUBLIC_PUSH_MODE=demo

# Only for a local Android push demonstration. Keep both the Firebase file and
# the service-account key out of Git and out of the submission archive.
# EXPO_PUBLIC_PUSH_MODE=live
# EXPO_PUBLIC_GOOGLE_SERVICES_FILE=./google-services.json

# Submission-safe default: no Google Maps key is needed in this mode.
EXPO_PUBLIC_MAP_MODE=demo

# M7: demo is the submission-safe default. Set live only for local verification
# after the official flood-risk-map WMS/GeoJSON connection is configured.
EXPO_PUBLIC_FLOOD_MAP_MODE=demo

# Only for a local demonstration video. Keep the real key in .env.local.
# EXPO_PUBLIC_MAP_MODE=google
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# LIVE 장소 검색 키는 앱에 넣지 않습니다. 백엔드의 GOOGLE_PLACES_API_KEY로만 설정합니다.
